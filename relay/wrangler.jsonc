{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-invaders-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "CODES", "class_name": "Codes" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Codes"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://lime-fleet-invaders.vercel.app"
  },
  "observability": { "enabled": true }
}
